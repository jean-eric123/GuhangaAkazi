    <script>
    (function () {
        var tabs = document.querySelectorAll('[data-lang-tab]');
        var panels = document.querySelectorAll('[data-lang-panel]');
        var btn = document.getElementById('btnTranslate');

        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                var lang = tab.getAttribute('data-lang-tab');
                tabs.forEach(function (t) {
                    var active = t === tab;
                    t.style.borderBottomColor = active ? 'var(--brand)' : 'transparent';
                    t.style.color = active ? 'var(--brand)' : 'var(--text-muted)';
                });
                panels.forEach(function (p) {
                    p.style.display = p.getAttribute('data-lang-panel') === lang ? '' : 'none';
                });
                if (btn) {
                    if (lang === 'rw') {
                        btn.setAttribute('data-from', 'en');
                        btn.setAttribute('data-to', 'rw');
                        btn.textContent = '🌐 Auto-translate EN → RW';
                    } else {
                        btn.setAttribute('data-from', 'rw');
                        btn.setAttribute('data-to', 'en');
                        btn.textContent = '🌐 Auto-translate RW → EN';
                    }
                }
            });
        });

        var FIELDS = ['title','short_description','full_description','steps','requirements','tips'];

        if (btn) {
            btn.addEventListener('click', function () {
                var from = btn.getAttribute('data-from');
                var to   = btn.getAttribute('data-to');
                var payload = {};
                FIELDS.forEach(function (f) {
                    var el = document.getElementById(from + '_' + f);
                    if (el && el.value.trim() !== '') { payload[f] = el.value; }
                });
                if (Object.keys(payload).length === 0) {
                    alert('Please fill at least one ' + from.toUpperCase() + ' field first.');
                    return;
                }

                var hasExisting = FIELDS.some(function (f) {
                    var el = document.getElementById(to + '_' + f);
                    return el && el.value.trim() !== '';
                });
                if (hasExisting) {
                    if (! confirm('Some ' + to.toUpperCase() + ' fields already have content. Fill only empty fields?')) {
                        return;
                    }
                }

                btn.disabled = true;
                var originalText = btn.textContent;
                btn.textContent = '⏳ Translating...';

                fetch('{{ route('admin.translate') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRF-TOKEN': document.querySelector('meta[name="csrf-token"]').content,
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ from: from, to: to, fields: payload })
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (! data.ok) { throw new Error(data.error || 'Translation failed'); }
                    var filled = 0, skipped = 0;
                    FIELDS.forEach(function (f) {
                        if (! data.fields[f]) return;
                        var el = document.getElementById(to + '_' + f);
                        if (! el) return;
                        if (el.value.trim() !== '' && hasExisting) { skipped++; return; }
                        el.value = data.fields[f];
                        filled++;
                    });
                    alert('✅ Filled ' + filled + ' field(s)' + (skipped ? ', skipped ' + skipped + ' existing' : '') + '. Please review before saving.');
                })
                .catch(function (err) {
                    alert('⚠️ Translation failed: ' + err.message + '. Please translate manually.');
                })
                .finally(function () {
                    btn.disabled = false;
                    btn.textContent = originalText;
                });
            });
        }
    })();
    </script>
@endsection
